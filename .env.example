# ============================================================
# ROBOTREND IA v5.0.0 — ENVIRONMENT (desenvolvimento)
# Copie para .env:  copy .env.example .env
# Produção: use .env.production + npm run secrets:generate
# ============================================================

PORT=3010
NODE_ENV=development
# URL base do app (links, callbacks). Fallback: http://localhost:PORT
BASE_URL=http://localhost:3010
PUBLIC_URL=http://localhost:3010

# CORS / WebSocket (dev: vazio = permissivo local)
ALLOWED_ORIGINS=http://localhost:3010

# Produção: npm run secrets:generate (JWT/SESSION = hex 128 chars, mín. 32)
JWT_SECRET=troque_em_dev_apenas_nao_use_em_producao_32chars_min
SESSION_SECRET=dev_session_secret_troque_em_producao_32chars_min_ok
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=10
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# ============================================================
# Auth rate limit — separado do geral. Em produção default = 10/min/IP.
# Em development (NODE_ENV=development) default = 100/min/IP para não
# atrapalhar QA/testes locais. Override fino com as envs abaixo:
#   AUTH_RATE_LIMIT_MAX=200          → 200 tentativas/janela
#   AUTH_RATE_LIMIT_WINDOW_MS=60000  → janela de 1 min
#   AUTH_RATE_LIMIT_DISABLED=true    → desliga totalmente (SOMENTE em dev)
# Logs disparam [AUTH RATE LIMIT] sempre que um IP é bloqueado.
# ============================================================
# AUTH_RATE_LIMIT_MAX=100
# AUTH_RATE_LIMIT_WINDOW_MS=60000
# AUTH_RATE_LIMIT_DISABLED=false

# ============================================================
# MASTER ADMIN — bootstrap automático no boot
# ------------------------------------------------------------
# Defina BOOTSTRAP_ADMIN_EMAIL e BOOTSTRAP_ADMIN_PASSWORD no painel
# Environment do provider (Render/Fly/etc). NUNCA commite valores
# reais nesse arquivo.
#
# BOOTSTRAP_ADMIN_FORCE_RESET=true → reseta a senha do admin a cada
# boot (use para recuperar acesso; depois desligue).
# ============================================================
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_FORCE_RESET=false

# AUTH_VERBOSE=true → loga `[AUTH] JWT validated` em cada request autenticada
# AUTH_VERBOSE=false

PLAN_FREE_DAILY_SIGNALS=3
PLAN_VIP_DAILY_SIGNALS=30
PLAN_PREMIUM_DAILY_SIGNALS=999
PLAN_VIP_PRICE_BRL=49.90
PLAN_PREMIUM_PRICE_BRL=199.99
PLAN_PREMIUM_FULL_PRICE_BRL=499.99

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ENABLED=false

# ============================================================
# API-Football (API-Sports) — ÚNICA FONTE DE DADOS DE PARTIDAS
# ------------------------------------------------------------
# Signup: https://dashboard.api-football.com (free tier = 100 req/dia)
# Sem chave válida o painel exibe "Dados indisponíveis no momento.".
# NÃO existe provider sintético, demo, secundário ou de fallback.
#
# Header de autenticação enviado automaticamente: x-apisports-key
# ============================================================
API_FOOTBALL_KEY=
API_FOOTBALL_HOST=v3.football.api-sports.io
ODDS_API_KEY=

# Polling do live (ms). 30000 = 30 s (~2880 req/dia em /fixtures?live=all).
# AF_TTL_LIVE deve acompanhar o mesmo valor para deduplicar qualquer
# fallback (live.js/consensus) que peça /fixtures?live=all dentro do ciclo.
FOOTBALL_POLL_INTERVAL_MS=30000
AF_TTL_LIVE=30000

# Limitador local de quota — config para plano Pro (7500 req/dia).
# Defaults do código (apiFootball.js) são 95/dia e 5/min (free tier);
# sem estes envs o sistema bloqueia após ~48 min de polling a 30 s.
#   - DAY: 7000 deixa ~7% de margem dentro do limite oficial Pro (7500).
#   - MIN: 30 cobre poller (2/min) + enrich (2/req) + bursts REST.
API_FOOTBALL_RATE_PER_DAY=7000
API_FOOTBALL_RATE_PER_MIN=30

# Clock LOCAL — roda independente da API (mesmo em fallback/safe-mode).
# A cada FOOTBALL_FALLBACK_CLOCK_MS o poller emite `tick` com matches
# simulados (minute progride, pressureIndex faz drift). Garante que o
# painel nunca congele em 0' ou 120'.
# FOOTBALL_FALLBACK_CLOCK_MS=10000

# Lista (CSV) de tokens que descartam ligas do feed live.
# FOOTBALL_EXCLUDE_LEAGUES=Reserve,Women,U23,U21,U20,U19,U17,U16,Amateur,Kreisliga,2e Klasse,Bezirksliga,Youth

# Produção Render: use SOMENTE DATABASE_URL (Add from Database → robotrend-pg).
# NÃO defina PGHOST=postgres — causa getaddrinfo ENOTFOUND no deploy.
DATABASE_URL=
# PGHOST=postgres   ← NUNCA no Render (placeholder Docker)
PGHOST=
PGPORT=5432
PGUSER=
PGPASSWORD=
PGDATABASE=robotrend

STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_VIP=
STRIPE_PRICE_PREMIUM=

MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=
MP_WEBHOOK_SECRET=

PIX_KEY=
PIX_MERCHANT_NAME=Robotrend IA
PIX_MERCHANT_CITY=Sao Paulo

# Token opcional p/ Prometheus scrape em /api/metrics (header X-Metrics-Token)
METRICS_TOKEN=

SIGNAL_MIN_SCORE=80
LIVE_SCAN_INTERVAL_MS=15000

# Pré-live scheduler — alimenta o evento socket `prelive:update` para o
# painel SaaS sem depender de clique. Cada ciclo custa até 1+2×PRELIVE_MAX_FIXTURES
# chamadas (default 11). 600000 = 10min => ~1584 req/dia. Defina 0 para
# desligar o scheduler (a rota REST GET /api/prelive continua funcionando).
PRELIVE_REFRESH_MS=600000
# PRELIVE_MAX_FIXTURES=5

# ============================================================
# BET SIGNAL ENGINE — value-bets (corners / btts / win) contínuo
# ------------------------------------------------------------
# Filtros padrão (produção). Tudo opcional — defaults no código.
# ============================================================
# BET_SIGNAL_ENABLED=true
# BET_SIGNAL_TICK_MS=90000              # tick (ms)
# BET_SIGNAL_MIN_CONFIDENCE=65          # piso geral p/ emitir
# BET_SIGNAL_FREE_MIN_CONFIDENCE=65
# BET_SIGNAL_PREMIUM_MIN_CONFIDENCE=75
# BET_SIGNAL_MIN_ODD=1.80               # faixa de valor
# BET_SIGNAL_MAX_ODD=2.20
# BET_SIGNAL_MIN_MINUTE=20              # janela do jogo
# BET_SIGNAL_MAX_MINUTE=85
# BET_SIGNAL_COOLDOWN_MS=600000         # 10min por (match × market)
# BET_SIGNAL_RECENT_MAX=200             # ring buffer de sinais
# BET_SIGNAL_DROPS_MAX=100              # ring buffer de descartes (debug)

# === DIAGNÓSTICO / DEBUG ====================================
# Ative para investigar "por que nenhum sinal está sendo gerado".
# Veja:  GET /api/football/bet-signals/debug   (admin)
# Ou:    node scripts/diagnose-signals.js
# ------------------------------------------------------------
# Logs verbosos: cada decisão de drop/emit é logada com payload completo.
# BET_SIGNAL_DEBUG=false
# LIVE_SIGNAL_DEBUG=true                # logs [LIVE PIPELINE] match/candidate/EMIT/DROP (default true em dev)
# BET_SIGNAL_BOOTSTRAP_TOP=10           # jogos live com stats mínimos locais (zero API) p/ bet engine
# Fallback baseline xG (usado quando ENRICH_ENABLED=false / sem stats avançados)
# BET_SIGNAL_BASELINE_XG_PER_MIN=0.0185 # 1.67 gols/time/90min — calibrado p/ odd 1.80-2.20
# BET_SIGNAL_BASELINE_HOME_BUMP=0.10    # vantagem de mando histórica (~10%)
# Baseline para CORNERS quando stats avançados não chegaram (média de liga 9 em 90′).
# Sem isso, computeCornersBet retorna null silencioso quando corners.total=0.
# BET_SIGNAL_BASELINE_CORNERS_PER_MIN=0.10

# MODO TESTE — afrouxa TODOS os filtros pra validar funcionamento:
#   minConfidence → BET_SIGNAL_TEST_MIN_CONFIDENCE (default 70)
#   oddRange      → [1.20, 10.0]
#   minuteRange   → [1, 120]
#   cooldownMs    → 0
#   enrichedGate  → IGNORADO (processa fixtures parciais)
# NÃO USE EM PRODUÇÃO — só para diagnóstico.
# BET_SIGNAL_TEST_MODE=false
# BET_SIGNAL_TEST_MIN_CONFIDENCE=70

# ============================================================
# SIGNALS ENGINE — detectores reativos (event-driven)
# ============================================================
# SIGNALS_ENABLED=true
# SIGNALS_COOLDOWN_MS=360000            # 6min
# SIGNALS_DEBUG=false                   # logs verbosos por drop
# SIGNALS_DROPS_MAX=100
# SIGNALS_PRESSURE_MIN=70
# SIGNALS_PRESSURE_RAMP_DELTA=18
# SIGNALS_BTTS_MIN_MINUTE=35
# SIGNALS_BTTS_MAX_MINUTE=80
# SIGNALS_BTTS_MIN_PRESSURE=60
# SIGNALS_OVER_CORNERS_MIN_RATE=0.18
# SIGNALS_OVER_GOALS_MIN_RATE=0.035
# SIGNALS_RADAR_MIN_CONFIDENCE=70
# Só aceita jogos REAIS confirmados pela API (default: true em prod/staging).
# Em dev pode deixar false para tolerar partial data; true força guard estrito.
# (não existe mais scanner demo — quando não há provider real o painel
# exibe "Dados indisponíveis no momento.")
STRICT_REAL_ONLY=false
# Idade máxima (ms) do último update da API por match para emitir sinal.
SIGNAL_API_FRESH_MS=90000

# ============================================================
# Multi-API Consensus Engine
# ------------------------------------------------------------
# MATCH_CONSENSUS_MODE: define como o engine combina fontes
#   strict   → todas as fontes precisam concordar; divergência = descarte
#              (use só se você quer alta certeza e tem providers PAGOS estáveis)
#   relaxed  → DEFAULT recomendado. Aceita match em QUALQUER fonte,
#              anota sourceQuality = verified | partial | single-source.
#              Nunca descarta um jogo por divergência — só sinaliza.
#   off      → bypass total. Sem HTTP extra, todos viram single-source.
#              Use quando o poller único é fonte de verdade suficiente.
#
# Compat: se MATCH_CONSENSUS_MODE não estiver setado E STRICT_REAL_ONLY=true,
# default vira "strict" (comportamento legado). Caso contrário, "relaxed".
#
# SCANNER (/api/football/scanner) NUNCA usa consensus — sempre mostra todos.
# SIGNAL pipeline (live.js → analyzer) RESPEITA o modo configurado.
# ============================================================
MATCH_CONSENSUS_MODE=relaxed

CONSENSUS_RETRIES=3
CONSENSUS_RETRY_DELAY_MS=500
CONSENSUS_TS_TOLERANCE_MS=60000
CONSENSUS_FETCH_TIMEOUT_MS=10000
ANTI_FAKE_PRESSURE=true
ML_AUTOTUNE=true

FRESHNESS_PAST_HOURS=3
FRESHNESS_FUTURE_HOURS=24
WATCHDOG_INTERVAL_MS=30000
WATCHDOG_HEAP_MB=350
WATCHDOG_RSS_MB=500
WATCHDOG_P95_MS=1500
WATCHDOG_SELF_EXIT=true
